msgid "Entry %d was skipped because its data or linked items could not be matched."
msgstr ""
"Se ha omitido el registro %d porque no ha sido posible validar sus datos o relacionar sus "
"elementos."

msgid "Expiration and review follow-up"
msgstr "Vigencia y seguimiento de revisiones"

msgid "Expiration date"
msgstr "Fecha de caducidad"

