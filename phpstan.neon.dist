includes:
    - .ci/glpi/vendor/glpi-project/phpstan-glpi/extension.neon
    - .ci/glpi/vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - .ci/glpi/vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon

parameters:
    level: 5
    phpVersion: 80300
    paths:
        - src
        - front
        - setup.php
        - hook.php
    bootstrapFiles:
        - .ci/glpi/vendor/autoload.php
        - .ci/glpi/stubs/db_config_classes.php
        - .ci/glpi/stubs/glpi_constants.php
        - .ci/glpi/stubs/plugins_migrations_classes.php
    tmpDir: .cache/phpstan
    treatPhpDocTypesAsCertain: false
    glpi:
        glpiPath: .ci/glpi
        glpiVersion: '12.0.0'
        enableEarlierRulesAdoption: false
