parameters:
    level: 5
    phpVersion: 80300
    paths:
        - src
        - front
        - setup.php
        - hook.php
    bootstrapFiles:
        - .ci/glpi/vendor/autoload.php
        - .ci/glpi/stubs/db_config_classes.php
        - .ci/glpi/stubs/glpi_constants.php
        - .ci/glpi/stubs/plugins_migrations_classes.php
    tmpDir: .cache/phpstan
    treatPhpDocTypesAsCertain: false
