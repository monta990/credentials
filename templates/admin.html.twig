<div class="container-fluid plugin_credentials">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-1"><i class="ti ti-settings me-2" aria-hidden="true"></i>{{ __('Credentials administration', 'credentials') }}</h2>
            <p class="text-muted mb-0">{{ __('Manage plugin updates, organization categories, reviews, archived entries and protected backups.', 'credentials') }}</p>
        </div>
        <span class="badge bg-secondary">{{ __('Installed version', 'credentials') }}: {{ installed_version }}</span>
    </div>

    <section class="card mb-4">
        <div class="card-header"><h3 class="h4 mb-0"><i class="ti ti-brand-github me-2" aria-hidden="true"></i>{{ __('Plugin updates', 'credentials') }}</h3></div>
        <div class="card-body">
            {% if update.is_newer %}
                <div class="alert alert-warning" role="status">
                    <strong>{{ __('A new version is available.', 'credentials') }}</strong>
                    {{ __('Installed:', 'credentials') }} {{ installed_version }} ·
                    {{ __('Latest:', 'credentials') }} {{ update.latest }}
                </div>
            {% elseif update.is_current %}
                <div class="alert alert-success" role="status">{{ __('Credentials is up to date.', 'credentials') }} ({{ installed_version }})</div>
            {% elseif update.status == 'no_releases' %}
                <div class="alert alert-info" role="status">{{ __('There are no stable releases published on GitHub yet.', 'credentials') }}</div>
            {% else %}
                <div class="alert alert-warning" role="status">{{ __('GitHub could not be checked right now. The plugin will continue working normally.', 'credentials') }}{% if update.latest %} {{ __('Last known version:', 'credentials') }} {{ update.latest }}{% endif %}</div>
            {% endif %}

            {% if update.published_at %}
                <p class="text-muted mb-2">{{ __('Latest publication:', 'credentials') }} {{ update.published_at|date('Y-m-d H:i') }}</p>
            {% endif %}
            {% if update.notes %}
                <details class="mb-3">
                    <summary>{{ __('Release notes', 'credentials') }}</summary>
                    <div class="border rounded p-3 mt-2 text-break" style="white-space: pre-wrap">{{ update.notes }}</div>
                </details>
            {% endif %}
            <div class="d-flex flex-wrap gap-2 align-items-center">
                {% if can_manage_config %}
                <form method="post" action="{{ config_url|e('html_attr') }}">
                    <button class="btn btn-primary" type="submit" name="action" value="check_updates"><i class="ti ti-refresh me-1" aria-hidden="true"></i>{{ __('Check for updates', 'credentials') }}</button>
                </form>
                {% endif %}
                <a class="btn btn-secondary" href="{{ update.url|e('html_attr') }}" target="_blank" rel="noopener noreferrer"><i class="ti ti-brand-github me-1" aria-hidden="true"></i>{{ __('View GitHub releases', 'credentials') }}</a>
            </div>
            {% if update.checked_at %}
                <small class="text-muted d-block mt-2">{{ __('Last checked:', 'credentials') }} {{ update.checked_at|date('Y-m-d H:i:s') }}{% if update.stale %} — {{ __('showing cached information', 'credentials') }}{% endif %}</small>
            {% endif %}
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h3 class="h4 mb-0"><i class="ti ti-chart-bar me-2" aria-hidden="true"></i>{{ __('Credential overview', 'credentials') }}</h3></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="text-muted">{{ __('Active credentials', 'credentials') }}</div><div class="fs-2 fw-bold">{{ stats.active }}</div></div></div>
                <div class="col-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="text-muted">{{ __('Archived credentials', 'credentials') }}</div><div class="fs-2 fw-bold">{{ stats.archived }}</div></div></div>
                <div class="col-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="text-muted">{{ __('Expired credentials', 'credentials') }}</div><div class="fs-2 fw-bold">{{ stats.expired }}</div></div></div>
                <div class="col-6 col-lg-3"><div class="border rounded p-3 h-100"><div class="text-muted">{{ __('Reviews due', 'credentials') }}</div><div class="fs-2 fw-bold">{{ stats.review_due }}</div></div></div>
            </div>
            <p class="text-muted small mt-3 mb-0">{{ __('This overview shows only credentials within the entities available to your GLPI account. Secret values are never displayed here.', 'credentials') }}</p>
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h3 class="h4 mb-0"><i class="ti ti-tags me-2" aria-hidden="true"></i>{{ __('Categories and retention', 'credentials') }}</h3></div>
        <div class="card-body">
            {% if can_manage_config %}
            <form method="post" action="{{ config_url|e('html_attr') }}">
                <input type="hidden" name="action" value="save_settings">
                <div class="row g-3">
                    <div class="col-lg-7">
                        <label class="form-label" for="credentials-categories">{{ __('Credential categories', 'credentials') }}</label>
                        <textarea class="form-control" id="credentials-categories" name="categories" rows="8">{{ categories_text }}</textarea>
                        <small class="form-text text-muted">{{ __('Enter one category per line. Existing credentials keep their category even if you later remove it from this list.', 'credentials') }}</small>
                    </div>
                    <div class="col-lg-5">
                        <label class="form-label" for="credentials-retention">{{ __('Archived credential retention (days)', 'credentials') }}</label>
                        <input class="form-control" type="number" min="0" max="3650" step="1" id="credentials-retention" name="retention_days" value="{{ retention_days }}">
                        <small class="form-text text-muted">{{ __('Use 0 to keep archived entries until an administrator removes them manually. Retention never deletes anything automatically.', 'credentials') }}</small>
                    </div>
                </div>
                <div class="mt-3 text-end"><button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ __('Save settings', 'credentials') }}</button></div>
            </form>
            {% else %}
                <p class="text-muted">{{ __('You can view these settings, but your profile cannot change them.', 'credentials') }}</p>
            {% endif %}
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h3 class="h4 mb-0"><i class="ti ti-calendar-check me-2" aria-hidden="true"></i>{{ __('Credential reviews', 'credentials') }}</h3></div>
        <div class="card-body">
            {% if review_rows is empty %}
                <div class="alert alert-success mb-0">{{ __('There are no credential reviews due right now.', 'credentials') }}</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>{{ __('Credential', 'credentials') }}</th><th>{{ __('Category', 'credentials') }}</th><th>{{ __('Review due', 'credentials') }}</th><th>{{ __('Expiration', 'credentials') }}</th><th class="text-end">{{ __('Action', 'credentials') }}</th></tr></thead>
                        <tbody>
                        {% for row in review_rows %}
                            <tr>
                                <td><strong>{{ row.name }}</strong> <span class="text-muted">#{{ row.id }}</span></td>
                                <td>{{ row.category }}</td>
                                <td>{{ row.due_date }}</td>
                                <td>{{ row.expires_at ?: '—' }}</td>
                                <td class="text-end">
                                    {% if can_update_credentials %}
                                    <form method="post" action="{{ config_url|e('html_attr') }}">
                                        <input type="hidden" name="action" value="mark_reviewed">
                                        <input type="hidden" name="credential_id" value="{{ row.id }}">
                                        <button class="btn btn-sm btn-primary" type="submit">{{ __('Mark reviewed today', 'credentials') }}</button>
                                    </form>
                                    {% else %}
                                        <span class="text-muted">{{ __('Insufficient permission to update this credential.', 'credentials') }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h3 class="h4 mb-0"><i class="ti ti-archive me-2" aria-hidden="true"></i>{{ __('Archived credentials', 'credentials') }}</h3></div>
        <div class="card-body">
            <p class="text-muted">{{ __('Archived entries are not shown in normal user, asset or ticket tabs. Restore an entry to make it active again. If its original item no longer exists, select a supported item type and enter an item ID to create a new association.', 'credentials') }}</p>
            {% if archive_rows is empty %}
                <div class="alert alert-info mb-0">{{ __('There are no archived credentials.', 'credentials') }}</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>{{ __('Credential', 'credentials') }}</th><th>{{ __('Category', 'credentials') }}</th><th>{{ __('Archived', 'credentials') }}</th><th>{{ __('Reason', 'credentials') }}</th><th>{{ __('Linked items', 'credentials') }}</th><th>{{ __('Actions', 'credentials') }}</th></tr></thead>
                        <tbody>
                        {% for row in archive_rows %}
                            <tr>
                                <td><strong>{{ row.name }}</strong> <span class="text-muted">#{{ row.id }}</span></td>
                                <td>{{ row.category }}</td>
                                <td>{{ row.archived_at ?: '—' }}</td>
                                <td>{{ row.archive_reason ?: '—' }}</td>
                                <td>{{ row.link_count }}</td>
                                <td>
                                    {% if can_update_credentials %}
                                    <form method="post" action="{{ config_url|e('html_attr') }}" class="d-flex flex-wrap gap-1 align-items-center">
                                        <input type="hidden" name="credential_id" value="{{ row.id }}">
                                        <input type="hidden" name="action" value="restore">
                                        <select class="form-select form-select-sm" name="itemtype" aria-label="{{ __('Item type for restoration', 'credentials') }}">
                                            <option value="">{{ __('Use existing links', 'credentials') }}</option>
                                            {% for type in supported_types %}
                                                <option value="{{ type.value|e('html_attr') }}">{{ type.label }}</option>
                                            {% endfor %}
                                        </select>
                                        <input class="form-control form-control-sm" style="max-width: 90px" type="number" min="1" name="items_id" placeholder="{{ __('Item ID', 'credentials') }}">
                                        <button class="btn btn-sm btn-primary" type="submit">{{ __('Restore', 'credentials') }}</button>
                                    </form>
                                    <form method="post" action="{{ config_url|e('html_attr') }}" class="mt-1" data-credentials-confirm="{{ __('Permanently erase this archived credential and its encrypted values? Backups may still contain previous copies.', 'credentials')|e('html_attr') }}">
                                        <input type="hidden" name="credential_id" value="{{ row.id }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" name="action" value="erase">{{ __('Erase permanently', 'credentials') }}</button>
                                    </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if retention_days > 0 and can_update_credentials %}
                    <form method="post" action="{{ config_url|e('html_attr') }}" data-credentials-confirm="{{ __('Permanently erase all archived credentials older than the configured retention period? This cannot be undone.', 'credentials')|e('html_attr') }}">
                        <button class="btn btn-danger" type="submit" name="action" value="purge_eligible">{{ __('Erase entries past retention period', 'credentials') }}</button>
                    </form>
                {% endif %}
            {% endif %}
            <div class="alert alert-warning mt-3 mb-0">{{ __('Permanent erasure removes the encrypted values from the active GLPI database. It cannot remove copies kept in database backups or other exported files.', 'credentials') }}</div>
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h3 class="h4 mb-0"><i class="ti ti-file-shield me-2" aria-hidden="true"></i>{{ __('Encrypted backup and restore', 'credentials') }}</h3></div>
        <div class="card-body">
            <div class="alert alert-info">{{ __('Backups contain credential passwords and other protected information. The file is encrypted with a password you choose. Keep that password separately: it cannot be recovered if lost.', 'credentials') }}</div>
            {% if not encryption_ready %}
                <div class="alert alert-danger">{{ __('The GLPI security key is unavailable. Backup and restore are disabled until it is fixed.', 'credentials') }}</div>
            {% else %}
                {% if can_export %}
                    <form method="post" action="{{ export_url|e('html_attr') }}" class="border rounded p-3 mb-3">
                        <h4 class="h5">{{ __('Export credentials', 'credentials') }}</h4>
                        <label class="form-label" for="credentials-export-password">{{ __('Backup password (at least 12 characters)', 'credentials') }}</label>
                        <input class="form-control mb-2" type="password" minlength="12" maxlength="256" id="credentials-export-password" name="backup_password" autocomplete="new-password" required>
                        <button class="btn btn-primary" type="submit"><i class="ti ti-download me-1" aria-hidden="true"></i>{{ __('Download encrypted backup', 'credentials') }}</button>
                    </form>
                {% endif %}
                {% if can_import %}
                    <form method="post" action="{{ import_url|e('html_attr') }}" enctype="multipart/form-data" class="border rounded p-3">
                        <h4 class="h5">{{ __('Import credentials', 'credentials') }}</h4>
                        <label class="form-label" for="credentials-backup-file">{{ __('Encrypted backup file', 'credentials') }}</label>
                        <input class="form-control mb-2" type="file" id="credentials-backup-file" name="backup_file" accept=".json,application/json" required>
                        <label class="form-label" for="credentials-import-password">{{ __('Backup password', 'credentials') }}</label>
                        <input class="form-control mb-2" type="password" minlength="12" maxlength="256" id="credentials-import-password" name="backup_password" autocomplete="new-password" required>
                        <small class="form-text text-muted d-block mb-2">{{ __('To avoid linking a credential to the wrong asset or user, the import recreates only associations whose item type, ID, name and entity all match. Entries without a matching item are imported into the archive for manual restoration.', 'credentials') }}</small>
                        <button class="btn btn-secondary" type="submit"><i class="ti ti-upload me-1" aria-hidden="true"></i>{{ __('Import backup', 'credentials') }}</button>
                    </form>
                {% endif %}
                {% if not can_export or not can_import %}
                    <p class="text-muted small mt-3 mb-0">{{ __('Export and import require the appropriate credential and password permissions in addition to GLPI configuration access.', 'credentials') }}</p>
                {% endif %}
            {% endif %}
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header"><h3 class="h4 mb-0"><i class="ti ti-history me-2" aria-hidden="true"></i>{{ __('Administrative activity', 'credentials') }}</h3></div>
        <div class="card-body">
            {% if audit_rows is empty %}
                <p class="text-muted mb-0">{{ __('No administrative activity has been recorded yet.', 'credentials') }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead><tr><th>{{ __('Date', 'credentials') }}</th><th>{{ __('Credential ID', 'credentials') }}</th><th>{{ __('User', 'credentials') }}</th><th>{{ __('Action', 'credentials') }}</th><th>{{ __('Related item', 'credentials') }}</th></tr></thead>
                        <tbody>
                        {% for row in audit_rows %}
                            <tr>
                                <td>{{ row.date }}</td>
                                <td>{{ row.credential_id > 0 ? '#' ~ row.credential_id : '—' }}</td>
                                <td>{{ row.user }}</td>
                                <td>{{ row.action }}</td>
                                <td>{{ row.itemtype ? row.itemtype ~ ' #' ~ row.items_id : '—' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <small class="text-muted">{{ __('Showing the 50 most recent events. Passwords and other secret values are never included in this history.', 'credentials') }}</small>
            {% endif %}
        </div>
    </section>
</div>
