<div class="container-fluid plugin_credentials" data-credentials-detail-root="1">
    {% if is_in_modal %}
        <span id="credentials-modal-title-source" class="visually-hidden" data-icon="ti-key">{{ modal_title }}</span>
    {% else %}
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <h2 class="mb-0"><i class="ti ti-key me-2" aria-hidden="true"></i>{{ __('Credential details', 'credentials') }}</h2>
            <a class="btn btn-secondary btn-lg" href="{{ back_url|e('html_attr') }}"><i class="ti ti-arrow-left me-1" aria-hidden="true"></i>{{ __('Back to item', 'credentials') }}</a>
        </div>
    {% endif %}

    {% if modal_changed %}
        <div class="alert alert-success" role="status">{{ __('Credential updated successfully.', 'credentials') }}</div>
    {% endif %}

    {% if page_error %}
        <div class="alert alert-danger" role="alert">{{ page_error }}</div>
    {% endif %}

    {% if credential_id > 0 %}
        {% if details_error %}
            <div class="alert alert-danger" role="alert">{{ __('Stored credential details could not be decrypted. Editing is disabled to prevent accidental data loss.', 'credentials') }}</div>
        {% else %}
            <div class="card credentials-details-card">
                <div class="card-body">
                    <dl class="mb-0 credentials-details-list credentials-details-grid">
                        <div class="credentials-detail-field credentials-detail-field--half">
                            <dt>{{ __('Name', 'credentials') }}</dt>
                            <dd class="fw-semibold">{{ credential_name }}</dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--half">
                            <dt>{{ __('Linked items', 'credentials') }}</dt>
                            <dd>
                                {% if link_count > 0 %}
                                    <a class="btn btn-link p-0 credentials-linked-count" href="{{ linked_items_url|e('html_attr') }}"
                                       aria-label="{{ __('Show linked items', 'credentials')|e('html_attr') }}">
                                        <i class="ti ti-link me-1" aria-hidden="true"></i>{{ link_count }}
                                    </a>
                                {% else %}
                                    0
                                {% endif %}
                            </dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--third">
                            <dt>{{ __('Category', 'credentials') }}</dt>
                            <dd>{{ category_name ?: '—' }}</dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--third">
                            <dt>{{ __('Status', 'credentials') }}</dt>
                            <dd>
                                {% if credential_status.key in ['expired', 'review_overdue'] %}
                                    <span class="badge bg-danger">{{ credential_status.label }}</span>
                                {% elseif credential_status.key in ['expiring', 'review_due'] %}
                                    <span class="badge bg-warning text-dark">{{ credential_status.label }}</span>
                                {% else %}
                                    <span class="badge bg-success">{{ credential_status.label }}</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--third">
                            <dt>{{ __('Expiration date', 'credentials') }}</dt>
                            <dd>{{ date_expires ?: '—' }}</dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--third">
                            <dt>{{ __('Last reviewed', 'credentials') }}</dt>
                            <dd>{{ date_last_review ?: '—' }}</dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--third">
                            <dt>{{ __('Next review date', 'credentials') }}</dt>
                            <dd>{{ date_next_review ?: '—' }}</dd>
                        </div>
                        {% if reviewer_name %}
                            <div class="credentials-detail-field credentials-detail-field--third">
                                <dt>{{ __('Review responsible', 'credentials') }}</dt>
                                <dd>{{ reviewer_name }}</dd>
                            </div>
                        {% endif %}
                        <div class="credentials-detail-field credentials-detail-field--half">
                            <dt>{{ __('Username', 'credentials') }}</dt>
                            <dd class="text-break">{{ details.login }}</dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--half">
                            <dt>{{ __('URL', 'credentials') }}</dt>
                            <dd class="text-break">
                                {% if details.url %}
                                    {% if safe_url %}
                                        <a href="{{ details.url|e('html_attr') }}" target="_blank" rel="noopener noreferrer">{{ details.url }}</a>
                                    {% else %}
                                        {{ details.url }}
                                    {% endif %}
                                {% else %}
                                    —
                                {% endif %}
                            </dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--full">
                            <dt>{{ __('Notes', 'credentials') }}</dt>
                            <dd class="text-break">{% if details.notes %}{{ details.notes|e|nl2br }}{% else %}—{% endif %}</dd>
                        </div>
                        <div class="credentials-detail-field credentials-detail-field--full credentials-detail-field--password">
                            <dt>{{ __('Password', 'credentials') }}</dt>
                            <dd>
                                <div class="credentials-password-panel">
                                    {% if can_reveal and has_password %}
                                        <p class="credentials-password-hint" {% if revealed_password is not null %}hidden{% endif %}>{{ __('Password is hidden until you request it.', 'credentials') }}</p>
                                        <form id="credentials-reveal-form" method="post" action="{{ detail_url|e('html_attr') }}"
                                              data-credentials-reveal-form="1" {% if revealed_password is not null %}hidden{% endif %}>
                                            <input type="hidden" name="credential_id" value="{{ credential_id }}">
                                            <input type="hidden" name="reveal_password" value="1">
                                            <button class="btn btn-primary credentials-password-button" type="submit"
                                                    data-credentials-reveal-button="1"
                                                    data-loading-message="{{ __('Requesting password…', 'credentials')|e('html_attr') }}">
                                                <i class="ti ti-eye me-2" aria-hidden="true"></i>{{ __('Reveal password', 'credentials') }}
                                            </button>
                                        </form>
                                        <div id="credentials-password-revealed" class="credentials-password-revealed" {% if revealed_password is null %}hidden{% endif %}>
                                            <input id="credentials-revealed-value" class="form-control form-control-sm credentials-password-value" type="text" value="{{ revealed_password|default('')|e('html_attr') }}" readonly autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="{{ __('Revealed password', 'credentials')|e('html_attr') }}">
                                            <div class="credentials-password-buttons">
                                                <button type="button" class="btn btn-secondary credentials-password-button" id="credentials-copy-password"
                                                        data-copied-message="{{ __('Password copied to clipboard.', 'credentials')|e('html_attr') }}"
                                                        data-copy-denied-message="{{ __('Clipboard access was denied. Select the password and copy it manually.', 'credentials')|e('html_attr') }}"
                                                        data-copy-empty-message="{{ __('Reveal the password before copying it.', 'credentials')|e('html_attr') }}">
                                                    <i class="ti ti-copy me-2" aria-hidden="true"></i>{{ __('Copy password', 'credentials') }}
                                                </button>
                                                <button type="button" class="btn btn-secondary credentials-password-button" id="credentials-hide-password"
                                                        data-hidden-message="{{ __('Password hidden.', 'credentials')|e('html_attr') }}">
                                                    <i class="ti ti-eye-off me-2" aria-hidden="true"></i>{{ __('Hide password', 'credentials') }}
                                                </button>
                                            </div>
                                        </div>
                                        <span id="credentials-password-status" class="credentials-password-status" role="status" aria-live="polite"></span>
                                    {% elseif can_reveal %}
                                        <p class="credentials-password-hint mb-0">{{ __('No password is stored for this credential.', 'credentials') }}</p>
                                    {% else %}
                                        <p class="credentials-password-hint mb-0">{{ __('You do not have permission to reveal this password.', 'credentials') }}</p>
                                    {% endif %}
                                </div>
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            {% if last_link and can_manage_relationships %}
                <div class="alert alert-warning mt-3" role="alert">
                    <i class="ti ti-alert-triangle me-1" aria-hidden="true"></i>
                    {{ __('This credential has only one linked item. It cannot be unlinked because credentials must always belong to at least one item. Delete the credential instead, if you have permission.', 'credentials') }}
                </div>
            {% endif %}

            <div class="d-flex flex-wrap gap-2 mt-3 credentials-modal-actions">
                {% if can_edit %}
                    <a class="btn btn-secondary btn-lg" href="{{ edit_url|e('html_attr') }}"><i class="ti ti-pencil me-2" aria-hidden="true"></i>{{ __('Edit credential', 'credentials') }}</a>
                {% endif %}
                {% if can_unlink %}
                    <form method="post" action="{{ detail_url|e('html_attr') }}" class="d-inline" data-credentials-confirm="{{ __('Unlink this credential from the current item?', 'credentials')|e('html_attr') }}">
                        <input type="hidden" name="credential_id" value="{{ credential_id }}">
                        <button class="btn btn-secondary btn-lg" type="submit" name="unlink" value="1"><i class="ti ti-link-off me-2" aria-hidden="true"></i>{{ __('Unlink', 'credentials') }}</button>
                    </form>
                {% endif %}
                {% if can_delete %}
                    <form method="post" action="{{ detail_url|e('html_attr') }}" class="d-inline" data-credentials-confirm="{{ delete_confirmation|e('html_attr') }}">
                        <input type="hidden" name="credential_id" value="{{ credential_id }}">
                        <button class="btn btn-danger btn-lg credentials-delete-button" type="submit" name="delete" value="1"><i class="ti ti-trash me-2" aria-hidden="true"></i>{{ __('Delete credential', 'credentials') }}</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</div>

{% if detail_js_url is defined %}
    <script src="{{ detail_js_url|e('html_attr') }}"></script>
{% endif %}
{% if is_in_modal and frame_js_url is defined %}
    <script src="{{ frame_js_url|e('html_attr') }}"></script>
{% endif %}
