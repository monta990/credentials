<div class="container-fluid plugin_credentials">
    {% if is_in_modal %}
        <span id="credentials-modal-title-source" class="visually-hidden" data-icon="{% if is_update %}ti-pencil{% else %}ti-plus{% endif %}">{{ modal_title }}</span>
    {% else %}
        <h2 class="mb-3"><i class="ti {% if is_update %}ti-pencil{% else %}ti-plus{% endif %} me-2" aria-hidden="true"></i>{{ modal_title }}</h2>
    {% endif %}

    <p class="text-muted mb-3">{{ __('Associated item', 'credentials') }}: {{ associated_item_name }}</p>

    {% for error in errors %}
        <div class="alert alert-danger" role="alert">{{ error }}</div>
    {% endfor %}

    <form method="post" action="{{ form_url|e('html_attr') }}" autocomplete="off">
        <div class="row mb-3">
            <label for="credentials-name" class="col-sm-3 col-form-label">{{ __('Name', 'credentials') }} <span class="text-danger">*</span></label>
            <div class="col-sm-9"><input class="form-control form-control-lg" id="credentials-name" name="name" type="text" maxlength="255" required value="{{ values.name }}"></div>
        </div>
        <div class="row mb-3">
            <label for="credentials-category" class="col-sm-3 col-form-label">{{ __('Category', 'credentials') }}</label>
            <div class="col-sm-9">
                <input class="form-control form-control-lg" id="credentials-category" name="category" type="text" maxlength="100" list="credentials-categories" value="{{ values.category }}">
                <datalist id="credentials-categories">{% for category in categories %}<option value="{{ category }}">{% endfor %}</datalist>
            </div>
        </div>
        <div class="row mb-3">
            <label for="credentials-expires-at" class="col-sm-3 col-form-label">{{ __('Expiration date', 'credentials') }}</label>
            <div class="col-sm-9"><input class="form-control form-control-lg" id="credentials-expires-at" name="expires_at" type="date" value="{{ values.expires_at }}"></div>
        </div>
        <div class="row mb-3">
            <label for="credentials-review-due-at" class="col-sm-3 col-form-label">{{ __('Next review', 'credentials') }}</label>
            <div class="col-sm-9"><input class="form-control form-control-lg" id="credentials-review-due-at" name="review_due_at" type="date" value="{{ values.review_due_at }}"></div>
        </div>
        <div class="row mb-3">
            <label for="credentials-login" class="col-sm-3 col-form-label">{{ __('Username', 'credentials') }}</label>
            <div class="col-sm-9"><input class="form-control form-control-lg" id="credentials-login" name="login" type="text" maxlength="255" autocomplete="off" value="{{ values.login }}"></div>
        </div>
        <div class="row mb-3">
            <label for="credentials-password" class="col-sm-3 col-form-label">{{ __('Password', 'credentials') }}</label>
            <div class="col-sm-9">
                <input class="form-control form-control-lg" id="credentials-password" name="password" type="password" autocomplete="new-password" value="" {% if not is_update %}required{% endif %}>
                <small class="form-hint">{% if is_update %}{{ __('Leave blank to keep the current password.', 'credentials') }}{% else %}{{ __('Credential details and the password are encrypted with the GLPI instance security key before they are stored.', 'credentials') }}{% endif %}</small>
            </div>
        </div>
        <div class="row mb-3">
            <label for="credentials-url" class="col-sm-3 col-form-label">{{ __('URL', 'credentials') }}</label>
            <div class="col-sm-9"><input class="form-control form-control-lg" id="credentials-url" name="url" type="url" maxlength="2048" placeholder="https://" value="{{ values.url }}"></div>
        </div>
        <div class="row mb-3">
            <label for="credentials-notes" class="col-sm-3 col-form-label">{{ __('Notes', 'credentials') }}</label>
            <div class="col-sm-9"><textarea class="form-control form-control-lg" id="credentials-notes" name="notes" rows="5">{{ values.notes }}</textarea></div>
        </div>
        <div class="d-flex gap-2 justify-content-end credentials-modal-actions">
            {% if is_in_modal and return_to_details %}
                <a class="btn btn-secondary btn-lg" href="{{ cancel_url|e('html_attr') }}"><i class="ti ti-x me-1" aria-hidden="true"></i>{{ __('Cancel', 'credentials') }}</a>
            {% elseif is_in_modal %}
                <button class="btn btn-secondary btn-lg" type="button" data-credentials-close-modal="1"><i class="ti ti-x me-1" aria-hidden="true"></i>{{ __('Cancel', 'credentials') }}</button>
            {% else %}
                <a class="btn btn-secondary btn-lg" href="{{ cancel_url|e('html_attr') }}"><i class="ti ti-x me-1" aria-hidden="true"></i>{{ __('Cancel', 'credentials') }}</a>
            {% endif %}
            <button class="btn btn-primary btn-lg" type="submit" name="save" value="1" {% if not encryption_ready %}disabled{% endif %}><i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ __('Save', 'credentials') }}</button>
        </div>
    </form>
</div>

{% if is_in_modal and form_frame_js_url is defined %}
    <script src="{{ form_frame_js_url|e('html_attr') }}"></script>
{% endif %}
