<div class="container-fluid plugin_credentials credentials-form-page">
    {% if is_in_modal %}
        <span id="credentials-modal-title-source" class="visually-hidden" data-icon="{% if is_update %}ti-pencil{% else %}ti-plus{% endif %}">{{ modal_title }}</span>
    {% else %}
        <h2 class="mb-3"><i class="ti {% if is_update %}ti-pencil{% else %}ti-plus{% endif %} me-2" aria-hidden="true"></i>{{ modal_title }}</h2>
    {% endif %}

    <div class="credentials-associated-item" role="note">
        <i class="ti ti-link" aria-hidden="true"></i>
        <span>{{ __('Associated item', 'credentials') }}:</span>
        <strong>{{ associated_item_name }}</strong>
    </div>

    {% for error in errors %}
        <div class="alert alert-danger" role="alert">{{ error }}</div>
    {% endfor %}

    <form method="post" action="{{ form_url|e('html_attr') }}" autocomplete="off">
        <div class="credentials-form-grid">
            <div class="credentials-form-field credentials-form-field--full">
                <label for="credentials-name" class="form-label">{{ __('Name', 'credentials') }} <span class="text-danger">*</span></label>
                <input class="form-control form-control-lg" id="credentials-name" name="name" type="text" maxlength="255" required value="{{ values.name }}">
            </div>

            <div class="credentials-form-field credentials-form-field--half">
                <label for="credentials-login" class="form-label">{{ __('Username', 'credentials') }}</label>
                <input class="form-control form-control-lg" id="credentials-login" name="login" type="text" maxlength="255" autocomplete="off" value="{{ values.login }}">
            </div>

            <div class="credentials-form-field credentials-form-field--half">
                <label for="credentials-password" class="form-label">{{ __('Password', 'credentials') }}</label>
                <input class="form-control form-control-lg" id="credentials-password" name="password" type="password" autocomplete="new-password" value="" {% if not is_update %}required{% endif %}>
                <small class="form-hint">{% if is_update %}{{ __('Leave blank to keep the current password.', 'credentials') }}{% else %}{{ __('Credential details and the password are encrypted with the GLPI instance security key before they are stored.', 'credentials') }}{% endif %}</small>
            </div>

            <div class="credentials-form-field credentials-form-field--half">
                <label for="credentials-url" class="form-label">{{ __('URL', 'credentials') }}</label>
                <input class="form-control form-control-lg" id="credentials-url" name="url" type="url" maxlength="2048" placeholder="https://" value="{{ values.url }}">
            </div>

            <div class="credentials-form-field credentials-form-field--half">
                <label for="credentials-category" class="form-label">{{ __('Category', 'credentials') }}</label>
                <select class="form-select form-select-lg" id="credentials-category" name="category_id">
                    <option value="0">{{ __('No category', 'credentials') }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if values.category_id == category.id %}selected{% endif %}>{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="credentials-form-field credentials-form-field--full">
                <label for="credentials-notes" class="form-label">{{ __('Notes', 'credentials') }}</label>
                <textarea class="form-control" id="credentials-notes" name="notes" rows="3">{{ values.notes }}</textarea>
            </div>

            <div class="credentials-form-field credentials-form-field--third">
                <label for="credentials-date-expires" class="form-label">{{ __('Expiration date', 'credentials') }}</label>
                <input class="form-control form-control-lg" id="credentials-date-expires" name="date_expires" type="date" value="{{ values.date_expires }}">
            </div>

            <div class="credentials-form-field credentials-form-field--third">
                <label for="credentials-date-last-review" class="form-label">{{ __('Last reviewed', 'credentials') }}</label>
                <input class="form-control form-control-lg" id="credentials-date-last-review" name="date_last_review" type="date" value="{{ values.date_last_review }}">
            </div>

            <div class="credentials-form-field credentials-form-field--third">
                <label for="credentials-date-next-review" class="form-label">{{ __('Next review date', 'credentials') }}</label>
                <input class="form-control form-control-lg" id="credentials-date-next-review" name="date_next_review" type="date" value="{{ values.date_next_review }}">
            </div>

            <div class="credentials-form-field credentials-form-field--half">
                <label for="credentials-reviewer" class="form-label">{{ __('Review responsible', 'credentials') }}</label>
                <select class="form-select form-select-lg" id="credentials-reviewer" name="reviewer_users_id">
                    <option value="0">{{ __('Not assigned', 'credentials') }}</option>
                    {% for reviewer in reviewer_options %}
                        <option value="{{ reviewer.id }}" {% if values.reviewer_users_id == reviewer.id %}selected{% endif %}>{{ reviewer.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="credentials-form-field credentials-form-field--half credentials-form-reminder">
                <i class="ti ti-info-circle" aria-hidden="true"></i>
                <p class="form-hint">{{ __('Review dates and the responsible person are reminders for administrators. They do not change or rotate passwords automatically.', 'credentials') }}</p>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end credentials-modal-actions mt-3">
            {% if is_in_modal and return_to_details %}
                <a class="btn btn-secondary btn-lg" href="{{ cancel_url|e('html_attr') }}"><i class="ti ti-x me-1" aria-hidden="true"></i>{{ __('Cancel', 'credentials') }}</a>
            {% elseif is_in_modal %}
                <button class="btn btn-secondary btn-lg" type="button" data-credentials-close-modal="1"><i class="ti ti-x me-1" aria-hidden="true"></i>{{ __('Cancel', 'credentials') }}</button>
            {% else %}
                <a class="btn btn-secondary btn-lg" href="{{ cancel_url|e('html_attr') }}"><i class="ti ti-x me-1" aria-hidden="true"></i>{{ __('Cancel', 'credentials') }}</a>
            {% endif %}
            <button class="btn btn-primary btn-lg" type="submit" name="save" value="1" {% if not encryption_ready %}disabled{% endif %}><i class="ti ti-device-floppy me-1" aria-hidden="true"></i>{{ __('Save', 'credentials') }}</button>
        </div>
    </form>
</div>

{% if is_in_modal and form_frame_js_url is defined %}
    <script src="{{ form_frame_js_url|e('html_attr') }}"></script>
{% endif %}
