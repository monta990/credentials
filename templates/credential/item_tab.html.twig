<div class="plugin_credentials p-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-1"><i class="ti ti-key me-2" aria-hidden="true"></i>{{ __('Credentials', 'credentials') }}</h3>
            <p class="text-muted mb-0">{{ __('Credential names are listed here. Open an entry to view protected details.', 'credentials') }}</p>
        </div>
        {% if can_create and encryption_ready %}
            {{ add_modal_markup|raw }}
            <a class="btn btn-primary" href="#{{ add_modal_id|e('html_attr') }}" data-bs-toggle="modal" data-bs-target="#{{ add_modal_id|e('html_attr') }}" data-credentials-count-url="{{ count_url|default('')|e('html_attr') }}">
                <i class="ti ti-plus me-1" aria-hidden="true"></i>{{ add_button_label }}
            </a>
        {% endif %}
    </div>

    {% if not encryption_ready %}
        <div class="alert alert-warning" role="alert">{{ __('Credential data cannot be decrypted until the GLPI security key is available.', 'credentials') }}</div>
    {% elseif rows is empty %}
        <div class="alert alert-info" role="status">{{ __('No credentials are associated with this item yet.', 'credentials') }}</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover table-card">
                <thead>
                    <tr>
                        <th scope="col">{{ __('Name', 'credentials') }}</th>
                        <th scope="col">{{ __('Linked items', 'credentials') }}</th>
                        <th scope="col">{{ __('Last update', 'credentials') }}</th>
                        <th scope="col" class="text-end">{{ __('Actions', 'credentials') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td><i class="ti ti-key me-2 text-muted" aria-hidden="true"></i><strong>{{ row.name }}</strong></td>
                            <td class="text-nowrap">
                                {{ row.links_modal_markup|raw }}
                                <a class="btn btn-link p-0 credentials-linked-count" href="#{{ row.links_modal_id|e('html_attr') }}"
                                   data-bs-toggle="modal" data-bs-target="#{{ row.links_modal_id|e('html_attr') }}"
                                   data-credentials-count-url="{{ row.count_url|e('html_attr') }}"
                                   aria-label="{{ __('Show linked items for credential', 'credentials')|e('html_attr') }}: {{ row.name|e('html_attr') }}">
                                    <i class="ti ti-link me-1" aria-hidden="true"></i>{{ row.link_count }}
                                </a>
                            </td>
                            <td class="text-muted">{{ row.date_mod ?? '—' }}</td>
                            <td class="text-end text-nowrap">
                                <div class="credentials-row-actions">
                                {{ row.detail_modal_markup|raw }}
                                <a class="btn btn-icon btn-ghost-secondary credentials-action-button" href="#{{ row.detail_modal_id|e('html_attr') }}" data-bs-toggle="modal" data-bs-target="#{{ row.detail_modal_id|e('html_attr') }}" data-credentials-count-url="{{ row.count_url|e('html_attr') }}" title="{{ __('View details', 'credentials')|e('html_attr') }}" aria-label="{{ __('View details', 'credentials')|e('html_attr') }}">
                                    <i class="ti ti-eye" aria-hidden="true"></i>
                                </a>
                                {% if can_update and row.edit_modal_markup is defined %}
                                    {{ row.edit_modal_markup|raw }}
                                    <a class="btn btn-icon btn-ghost-secondary credentials-action-button" href="#{{ row.edit_modal_id|e('html_attr') }}" data-bs-toggle="modal" data-bs-target="#{{ row.edit_modal_id|e('html_attr') }}" data-credentials-count-url="{{ row.count_url|e('html_attr') }}" title="{{ __('Edit credential', 'credentials')|e('html_attr') }}" aria-label="{{ __('Edit credential', 'credentials')|e('html_attr') }}">
                                        <i class="ti ti-pencil" aria-hidden="true"></i>
                                    </a>
                                    {% if row.unlink_url is defined %}
                                        <form method="post" action="{{ row.unlink_url|e('html_attr') }}" class="d-inline" data-credentials-confirm="{{ __('Unlink this credential from the current item?', 'credentials')|e('html_attr') }}">
                                            <input type="hidden" name="credential_id" value="{{ row.id }}">
                                            <button class="btn btn-icon btn-ghost-secondary credentials-action-button" type="submit" name="unlink" value="1" title="{{ __('Unlink', 'credentials')|e('html_attr') }}" aria-label="{{ __('Unlink', 'credentials')|e('html_attr') }}">
                                                <i class="ti ti-link-off" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    {% else %}
                                        <button class="btn btn-icon btn-ghost-secondary credentials-action-button" type="button" disabled title="{{ __('Cannot unlink the last linked item. Delete the credential instead.', 'credentials')|e('html_attr') }}" aria-label="{{ __('Cannot unlink the last linked item. Delete the credential instead.', 'credentials')|e('html_attr') }}">
                                            <i class="ti ti-lock" aria-hidden="true"></i>
                                        </button>
                                    {% endif %}
                                {% endif %}
                                {% if can_delete and row.delete_url is defined %}
                                    <form method="post" action="{{ row.delete_url|e('html_attr') }}" class="d-inline" data-credentials-confirm="{{ __('Delete this credential for all linked items? This cannot be undone.', 'credentials')|e('html_attr') }}">
                                        <input type="hidden" name="credential_id" value="{{ row.id }}">
                                        <button class="btn btn-icon btn-ghost-danger credentials-action-button" type="submit" name="delete" value="1" title="{{ __('Delete credential', 'credentials')|e('html_attr') }}" aria-label="{{ __('Delete credential', 'credentials')|e('html_attr') }}">
                                            <i class="ti ti-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if can_create %}
        <details class="credentials-link-existing mt-3">
            <summary class="text-muted">{{ __('Link an existing credential', 'credentials') }}</summary>
            <p class="text-muted mt-2 mb-3">{{ __('Filter credentials by category, then choose the credential by name.', 'credentials') }}</p>
            {% if linkable_credentials is not empty %}
                <form method="post" action="{{ link_existing_url|e('html_attr') }}" class="row g-3 align-items-end">
                    <input type="hidden" name="link_existing" value="1">
                    <div class="col-md-4">
                        <label class="form-label" for="credentials-link-category">{{ __('Category', 'credentials') }}</label>
                        <select class="form-select" id="credentials-link-category" data-credentials-category-filter>
                            <option value="all">{{ __('All categories', 'credentials') }}</option>
                            <option value="0">{{ __('No category', 'credentials') }}</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}">{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="credentials-link-search">{{ __('Search credentials by name', 'credentials') }}</label>
                        <input class="form-control mb-2" id="credentials-link-search" type="search" autocomplete="off" data-credentials-name-filter placeholder="{{ __('Type a credential name...', 'credentials')|e('html_attr') }}">
                        <label class="form-label" for="credentials-link-credential">{{ __('Select a credential', 'credentials') }}</label>
                        <select class="form-select" id="credentials-link-credential" name="credential_id" required>
                            <option value="">{{ __('Select a credential', 'credentials') }}</option>
                            {% for credential in linkable_credentials %}
                                <option value="{{ credential.id }}" data-category-id="{{ credential.category_id }}">{{ credential.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" type="submit"><i class="ti ti-link me-1" aria-hidden="true"></i>{{ __('Link', 'credentials') }}</button>
                    </div>
                </form>
                <small class="text-muted d-block mt-2">{{ __('A credential can be linked to several items. You must already have access to it through another linked item.', 'credentials') }}</small>
            {% else %}
                <div class="alert alert-info mb-0" role="status">{{ __('No eligible credentials are available to link.', 'credentials') }}</div>
            {% endif %}
        </details>
    {% endif %}
</div>
