<div class="container-fluid plugin_credentials">
    {% if is_in_modal %}
        <span id="credentials-modal-title-source" class="visually-hidden" data-icon="ti-link">{{ modal_title }}</span>
    {% else %}
        <h2 class="mb-3"><i class="ti ti-link me-2" aria-hidden="true"></i>{{ modal_title }}</h2>
    {% endif %}

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
        <div class="text-muted">
            {{ __('Credential ID', 'credentials') }}: <code class="credentials-id">#{{ credential_id }}</code>
            <span class="mx-2">·</span>
            {{ __('Name', 'credentials') }}: <strong>{{ credential_name }}</strong>
        </div>
        <a class="btn btn-secondary btn-lg" href="{{ back_url|e('html_attr') }}">
            <i class="ti ti-arrow-left me-2" aria-hidden="true"></i>{{ __('Back to credential', 'credentials') }}
        </a>
    </div>

    <p class="text-muted mb-3">
        {{ visible_count }} / {{ total_count }} {{ __('visible linked items', 'credentials') }}
    </p>

    {% if rows is not empty %}
        <div class="table-responsive">
            <table class="table table-hover table-card">
                <thead>
                    <tr>
                        <th scope="col" class="text-nowrap">{{ __('Item type', 'credentials') }}</th>
                        <th scope="col" class="text-nowrap">{{ __('Item ID', 'credentials') }}</th>
                        <th scope="col">{{ __('Item name', 'credentials') }}</th>
                        <th scope="col" class="text-nowrap">{{ __('Relationship', 'credentials') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.type_name }}</td>
                            <td><code>#{{ row.items_id }}</code></td>
                            <td><a href="{{ row.url|e('html_attr') }}">{{ row.name }}</a></td>
                            <td>{% if row.is_source %}<span class="badge bg-blue-lt">{{ __('Current item', 'credentials') }}</span>{% else %}—{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info" role="status">{{ __('No linked items are available to display.', 'credentials') }}</div>
    {% endif %}

    {% if hidden_count > 0 %}
        <div class="alert alert-warning mt-3" role="alert">
            <i class="ti ti-lock me-1" aria-hidden="true"></i>
            {{ hidden_count }} {{ __('linked items are hidden because you do not have permission to read them.', 'credentials') }}
        </div>
    {% endif %}
</div>

{% if is_in_modal and frame_js_url is defined %}
    <script src="{{ frame_js_url|e('html_attr') }}" defer></script>
{% endif %}
