<div class="plugin_credentials p-3">
    <div class="mb-3">
        <h3 class="mb-1"><i class="ti ti-key me-2" aria-hidden="true"></i>{{ __('Ticket credentials', 'credentials') }}</h3>
        <p class="text-muted mb-0">{{ __('Credentials linked to requester users and associated ticket items are shown here.', 'credentials') }}</p>
    </div>

    {% if rows is not empty %}
        <div class="table-responsive">
            <table class="table table-hover table-card">
                <thead>
                    <tr>
                        <th scope="col">{{ __('Credential ID', 'credentials') }}</th>
                        <th scope="col">{{ __('Name', 'credentials') }}</th>
                        <th scope="col">{{ __('Associated with', 'credentials') }}</th>
                        <th scope="col">{{ __('Last update', 'credentials') }}</th>
                        <th scope="col" class="text-end">{{ __('Actions', 'credentials') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td><code class="credentials-id">#{{ row.id }}</code></td>
                            <td><i class="ti ti-key me-2 text-muted" aria-hidden="true"></i><strong>{{ row.name }}</strong></td>
                            <td>{{ row.sources|join(', ') }}</td>
                            <td class="text-muted">{{ row.date_mod ?? '—' }}</td>
                            <td class="text-end">
                                <div class="credentials-row-actions">
                                {{ row.modal_markup|raw }}
                                <a class="btn btn-icon btn-ghost-secondary credentials-action-button" href="#{{ row.modal_id|e('html_attr') }}" data-bs-toggle="modal" data-bs-target="#{{ row.modal_id|e('html_attr') }}" data-credentials-count-url="{{ row.count_url|e('html_attr') }}" title="{{ __('View details', 'credentials')|e('html_attr') }}" aria-label="{{ __('View details', 'credentials')|e('html_attr') }}">
                                    <i class="ti ti-eye" aria-hidden="true"></i>
                                </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% elseif not requires_reauth %}
        <div class="alert alert-info" role="status">{{ __('No credentials were found for the ticket requesters or associated items.', 'credentials') }}</div>
    {% endif %}

    {% if requires_reauth and not secure_page %}
        <div class="alert alert-warning mt-3" role="alert">
            {{ __('Some credentials for requester users or ticket items require native GLPI re-authentication before they can be listed.', 'credentials') }}
            <a class="alert-link" href="{{ secure_url|e('html_attr') }}">{{ __('Authenticate and view all ticket credentials', 'credentials') }}</a>
        </div>
    {% elseif requires_reauth and secure_page %}
        <div class="alert alert-warning mt-3" role="alert">{{ __('Some requester users or ticket items remain unavailable after re-authentication because your profile cannot read them.', 'credentials') }}</div>
    {% endif %}

    {% if secure_page %}
        <div class="mt-3"><a class="btn btn-secondary" href="{{ back_url|e('html_attr') }}"><i class="ti ti-arrow-left me-1" aria-hidden="true"></i>{{ __('Back to ticket', 'credentials') }}</a></div>
    {% endif %}
</div>
